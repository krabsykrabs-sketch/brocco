DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brocco?schema=public"
ANTHROPIC_API_KEY=sk-ant-...
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=random-string-for-webhook-verification
# Printed by scripts/register-strava-webhook.ts — events without it are rejected
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
SESSION_SECRET=change-me-to-a-random-32-char-string!!
# Encrypts Strava / intervals.icu tokens at rest. Falls back to SESSION_SECRET
# for existing deployments — set it BEFORE ever rotating SESSION_SECRET, or the
# stored tokens become unreadable.
TOKEN_ENCRYPTION_KEY=
BASE_URL=https://brocco.run
GROQ_API_KEY=gsk_...           # Whisper voice transcription (console.groq.com)
# Email (password reset) — create a Resend account, verify the domain, then:
RESEND_API_KEY=re_...          # from resend.com dashboard
EMAIL_FROM="Brocco <no-reply@brocco.run>"
# Web Push (event reminders with the app closed) — self-generated, no account:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# SEED_PASSWORD=               # only needed to bootstrap a brand-new production DB
# Shared signup gate — hand this code to people you invite (defaults to brocco2026)
# SIGNUP_ACCESS_CODE=brocco2026
