generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  inviteCode   String?  @map("invite_code")
  /// Bumped on password/email change; sessions carrying an older value are
  /// rejected, which is what logs a stolen cookie out after a reset.
  sessionEpoch Int      @default(0) @map("session_epoch")
  createdAt    DateTime @default(now()) @map("created_at")

  profile           UserProfile?
  plans             Plan[]
  activities        Activity[]
  healthLog         HealthLog[]
  chatSessions      ChatSession[]
  pendingChanges    PendingPlanChange[]
  adjustmentLog     PlanAdjustmentLog[]
  createdInvites    InviteCode[]        @relation("CreatedInvites")
  usedInvite        InviteCode?         @relation("UsedInvite")
  events            Event[]
  todos             Todo[]
  taskLists         TaskList[]
  notes             Note[]
  dailyBriefings    DailyBriefing[]
  passwordResets    PasswordResetToken[]
  weeklyReviews     WeeklyReview[]
  pushSubscriptions PushSubscription[]
  journalEntries    JournalEntry[]
  guidedWorkouts    GuidedWorkout[]
  guidedWorkoutSessions GuidedWorkoutSession[]
  recipes           Recipe[]
  weeklyGoals       WeeklyGoal[]

  @@map("users")
}

model UserProfile {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  goalRace              String?  @map("goal_race")
  goalRaceDate          DateTime? @map("goal_race_date") @db.Date
  goalTime              String?  @map("goal_time")
  yearsRunning          Int?     @map("years_running")
  weeklyKmBaseline      Decimal? @map("weekly_km_baseline") @db.Decimal(6, 2)
  timezone              String   @default("Europe/Berlin")
  stravaAccessToken     String?  @map("strava_access_token")
  stravaRefreshToken    String?  @map("strava_refresh_token")
  stravaAthleteId       String?  @map("strava_athlete_id")
  stravaTokenExpiresAt  DateTime? @map("strava_token_expires_at")
  stravaLastSyncAt      DateTime? @map("strava_last_sync_at")
  // Sync health: last failure message (null = healthy) and whether the
  // token is dead (revoked/expired refresh) so the UI can prompt reconnect
  // instead of the user's runs just silently stopping.
  stravaLastSyncError   String?   @map("strava_last_sync_error")
  stravaNeedsReconnect  Boolean   @default(false) @map("strava_needs_reconnect")
  hrMaxBpm              Int?     @map("hr_max_bpm")
  // Secret for the read-only ICS calendar feed URL; null until the user
  // creates a subscribe link in Settings
  icsToken              String?  @unique @map("ics_token")
  coachingNotes         Json     @default("{}") @map("coaching_notes") @db.JsonB
  aiPreferences         Json?    @map("ai_preferences") @db.JsonB
  // When Brocco last generated a chat opener (server-side gate: one analysis
  // per local day, or again when a new activity lands after this timestamp)
  lastOpenerAt          DateTime? @map("last_opener_at")
  // Kitchen staples the user always has in stock (string[]; considered in
  // every recipe suggestion without being listed each time)
  pantryStaples         Json?    @map("pantry_staples") @db.JsonB
  /// Kit the athlete actually owns — "resistance bands", "16kg kettlebell".
  /// Brocco prescribes around it instead of assuming a full gym or nothing.
  trainingEquipment     Json?    @map("training_equipment") @db.JsonB
  /// UI + Brocco output language ("en", "de", "es"). Null = not chosen yet,
  /// so the client falls back to the browser language.
  language              String?
  /// The athlete's main sport ("climbing", "cycling", …). Null = running —
  /// the default persona, so existing users are untouched.
  primarySport          String?  @map("primary_sport")
  // Watch sync via intervals.icu (bridges to COROS/Garmin/…): planned
  // workouts are pushed to the user's intervals.icu calendar, which their
  // watch platform pulls. API key is encrypted like the Strava tokens.
  intervalsAthleteId    String?  @map("intervals_athlete_id")
  intervalsApiKey       String?  @map("intervals_api_key")
  // Life-planner feature toggles ({calendar, tasks, notes}); null = all enabled
  features              Json?    @db.JsonB
  onboardingCompleted   Boolean  @default(false) @map("onboarding_completed")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Plan {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  name      String
  goal      String?
  raceDate  DateTime?  @map("race_date") @db.Date
  startDate DateTime   @map("start_date") @db.Date
  endDate   DateTime   @map("end_date") @db.Date
  status    PlanStatus @default(draft)
  createdAt DateTime   @default(now()) @map("created_at")

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases      PlanPhase[]
  weeks       PlanWeek[]
  workouts    PlannedWorkout[]
  weeklyTasks WeeklyTask[]

  @@map("plans")
}

enum PlanStatus {
  active
  completed
  draft
}

model PlanPhase {
  id          String  @id @default(uuid()) @db.Uuid
  planId      String  @map("plan_id") @db.Uuid
  name        String
  orderIndex  Int     @map("order_index")
  description String?
  startWeek   Int     @map("start_week")
  endWeek     Int     @map("end_week")

  plan     Plan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  weeks    PlanWeek[]
  workouts PlannedWorkout[]

  @@map("plan_phases")
}

model PlanWeek {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  phaseId         String?         @map("phase_id") @db.Uuid
  weekNumber      Int             @map("week_number")
  startDate       DateTime        @map("start_date") @db.Date
  detailLevel     WeekDetailLevel @map("detail_level")
  targetKm        Decimal?        @map("target_km") @db.Decimal(6, 1)
  targetSessions  Int?            @map("target_sessions")
  sessionTypes    Json?           @map("session_types") @db.JsonB
  notes           String?
  actualKm        Decimal?        @map("actual_km") @db.Decimal(6, 1)
  /// Lease taken while an outline→detailed promotion is generating; stale
  /// (>10 min) leases are reclaimable, so a crash never strands a week.
  promotionClaimedAt DateTime?    @map("promotion_claimed_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  plan  Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  phase PlanPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@unique([planId, weekNumber])
  @@map("plan_weeks")
}

enum WeekDetailLevel {
  detailed
  outline
  target
}

enum WorkoutDetailLevel {
  detailed
  outline
}

model PlannedWorkout {
  id                String        @id @default(uuid()) @db.Uuid
  planId            String        @map("plan_id") @db.Uuid
  phaseId           String?       @map("phase_id") @db.Uuid
  weekNumber        Int           @map("week_number")
  date              DateTime      @db.Date
  title             String
  workoutType       WorkoutType   @map("workout_type")
  activityType      ActivityKind  @default(run) @map("activity_type")
  targetDistanceKm  Decimal?      @map("target_distance_km") @db.Decimal(6, 2)
  targetPace        String?       @map("target_pace")
  targetPaceSecs    Int?          @map("target_pace_secs")
  targetDurationMin Int?          @map("target_duration_min")
  description       String?
  // Structured interval steps for on-watch guidance (rendered to the
  // intervals.icu workout DSL): [{kind, distanceKm?, durationMin?, pace?,
  // label?} | {kind: "repeat", times, steps: [...]}]
  steps             Json?         @db.JsonB
  detailLevel       WorkoutDetailLevel @default(detailed) @map("detail_level")
  status            WorkoutStatus @default(planned)
  createdAt         DateTime      @default(now()) @map("created_at")

  plan            Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  phase           PlanPhase?         @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  adjustmentLog   PlanAdjustmentLog[]

  @@map("planned_workouts")
}

enum WorkoutType {
  easy
  long
  tempo
  interval
  race_pace
  recovery
  rest
  cross_training
  race
  strength
  // On-wall climbing session (bouldering, routes, hangboard lives in
  // strength). The session focus goes in title/description.
  climbing
}

enum ActivityKind {
  run
  cycle
  swim
  hike
  strength
  rest
  other
  climb
}

enum WorkoutStatus {
  planned
  completed
  skipped
  modified
}

model Activity {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  source            ActivitySource
  stravaId          String?       @map("strava_id")
  name              String
  activityType      String        @map("activity_type")
  distanceKm        Decimal?      @map("distance_km") @db.Decimal(8, 2)
  durationMin       Decimal       @map("duration_min") @db.Decimal(8, 2)
  movingTimeMin     Decimal?      @map("moving_time_min") @db.Decimal(8, 2)
  avgPacePerKm      String?       @map("avg_pace_per_km")
  paceSecondsPerKm  Int?          @map("pace_seconds_per_km")
  avgHeartRate      Int?          @map("avg_heart_rate")
  maxHeartRate      Int?          @map("max_heart_rate")
  elevationGainM    Decimal?      @map("elevation_gain_m") @db.Decimal(8, 2)
  avgCadence        Int?          @map("avg_cadence")
  // Running power (W) from watch/pod, straight off the Strava summary
  avgWatts          Int?          @map("avg_watts")
  calories          Int?
  perceivedEffort   Int?          @map("perceived_effort")
  startDate         DateTime      @map("start_date")
  startDateLocal    DateTime      @map("start_date_local")
  splits            Json?         @db.JsonB
  // Watch-recorded laps from the Strava Laps endpoint — ground truth for
  // interval execution (one lap per structured-workout step)
  laps              Json?         @db.JsonB
  rawData           Json?         @map("raw_data") @db.JsonB
  activityAnalysis  Json?         @map("activity_analysis") @db.JsonB
  createdAt         DateTime      @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalCredits     WeeklyGoalCredit[]

  @@unique([userId, stravaId])
  @@map("activities")
}

enum ActivitySource {
  strava
  manual
}

model HealthLog {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  date        DateTime        @db.Date
  entryType   HealthEntryType @map("entry_type")
  description String
  bodyPart    String?         @map("body_part")
  severity    Severity?
  status      HealthStatus?   @default(active)
  value       Decimal?        @db.Decimal(10, 2)
  createdAt   DateTime        @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_log")
}

enum HealthEntryType {
  injury
  note
  race_result
  weight
}

enum Severity {
  minor
  moderate
  severe
}

enum HealthStatus {
  active
  resolved
}

model ChatSession {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  title     String          @default("New conversation")
  type      ChatSessionType @default(general)
  /// Once the session's day is over, a few extracted lines (decisions,
  /// reasons, follow-ups) — Brocco's cross-day conversation memory.
  /// Empty string = summarized, nothing worth keeping (won't retry).
  summary   String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id              String      @id @default(uuid()) @db.Uuid
  sessionId       String      @map("session_id") @db.Uuid
  role            MessageRole
  content         Json        @db.JsonB
  displayText     String?     @map("display_text")
  contextSnapshot Json?       @map("context_snapshot") @db.JsonB
  createdAt       DateTime    @default(now()) @map("created_at")

  session        ChatSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  pendingChanges PendingPlanChange[]

  @@map("chat_messages")
}

enum MessageRole {
  user
  assistant
  tool_result
}

enum ChatSessionType {
  general
  onboarding
  plan_creation
  kitchen
}

model PendingPlanChange {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  chatMessageId   String              @map("chat_message_id") @db.Uuid
  changes         Json                @db.JsonB
  summary         String
  status          PendingChangeStatus @default(pending)
  createdAt       DateTime            @default(now()) @map("created_at")
  resolvedAt      DateTime?           @map("resolved_at")
  expiresAt       DateTime            @map("expires_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessage ChatMessage @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@map("pending_plan_changes")
}

enum PendingChangeStatus {
  pending
  approved
  rejected
  expired
}

model PlanAdjustmentLog {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  workoutId   String         @map("workout_id") @db.Uuid
  action      AdjustAction
  beforeState Json           @map("before_state") @db.JsonB
  afterState  Json           @map("after_state") @db.JsonB
  reason      String
  summary     String
  undone      Boolean        @default(false)
  createdAt   DateTime       @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout PlannedWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@map("plan_adjustment_log")
}

enum AdjustAction {
  update_targets
  swap_rest_day
  mark_covered
}

model WeeklyTask {
  id          String           @id @default(uuid()) @db.Uuid
  planId      String           @map("plan_id") @db.Uuid
  weekNumber  Int              @map("week_number")
  description String
  category    TaskCategory
  status      TaskStatus       @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("weekly_tasks")
}

enum TaskCategory {
  strength
  mobility
  nutrition
  recovery
  other
}

enum TaskStatus {
  pending
  done
}

// ============================================================
// Life planner — all tables below are additive (June 2026).
// Times on events/todos are stored as the user's local wall-clock
// time (no TZ conversion), matching the start_date_local convention.
// ============================================================

model Event {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  title              String
  location           String?
  notes              String?
  category           EventCategory  @default(other)
  startAt            DateTime       @map("start_at")
  endAt              DateTime?      @map("end_at")
  allDay             Boolean        @default(false) @map("all_day")
  recurrence         RecurrenceFreq @default(none)
  recurrenceInterval Int            @default(1) @map("recurrence_interval")
  recurrenceUntil    DateTime?      @map("recurrence_until") @db.Date
  recurrenceCount    Int?           @map("recurrence_count")
  // ISO dates ("yyyy-MM-dd") of occurrences deleted from a recurring series
  exdates            Json           @default("[]") @db.JsonB
  reminderMinutes    Int?           @map("reminder_minutes")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@map("events")
}

enum EventCategory {
  work
  family
  training
  social
  health
  birthday
  other
}

enum RecurrenceFreq {
  none
  daily
  weekly
  monthly
  yearly
}

model TaskList {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  emoji     String?
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos Todo[]

  @@map("task_lists")
}

// Named Todo to avoid colliding with the existing WeeklyTask training checklist.
model Todo {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String         @map("user_id") @db.Uuid
  listId             String?        @map("list_id") @db.Uuid
  parentId           String?        @map("parent_id") @db.Uuid
  title              String
  notes              String?
  dueDate            DateTime?      @map("due_date") @db.Date
  dueTime            String?        @map("due_time")
  priority           TodoPriority?
  recurrence         RecurrenceFreq @default(none)
  recurrenceInterval Int            @default(1) @map("recurrence_interval")
  // First due date of the series — regeneration is computed from here so a
  // "31st of every month" todo recovers to the 31st after short months.
  recurrenceAnchor   DateTime?      @map("recurrence_anchor") @db.Date
  done               Boolean        @default(false)
  completedAt        DateTime?      @map("completed_at")
  position           Int            @default(0)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  list     TaskList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  parent   Todo?     @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Todo[]    @relation("Subtasks")

  @@index([userId, done, dueDate])
  @@map("todos")
}

enum TodoPriority {
  low
  medium
  high
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String   @default("")
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("notes")
}

model DailyBriefing {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  date           DateTime @db.Date
  content        String
  lastActivityId String?  @map("last_activity_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_briefings")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // SHA-256 of the token — the raw value only ever exists in the emailed link
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model WeeklyReview {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // Monday of the week being reviewed
  weekStart DateTime @map("week_start") @db.Date
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("weekly_reviews")
}

// Mood check-ins and journal entries share one private timeline. `day` is
// the user's local wall-clock date ("yyyy-MM-dd") so grouping and the
// once-a-day mood prompt follow the user's timezone, not the server's.
model JournalEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  day       String
  // 1 (rough) … 5 (great); null for text-only journal entries
  mood      Int?
  // Context tags on mood check-ins, e.g. ["training", "work", "sleep"]
  tags      String[] @default([])
  text      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
  @@map("journal_entries")
}

// Kitchen helper: recipes scanned from book photos (Claude vision extracts
// the structured text; the photo itself is not stored), created via chat, or
// entered by hand. ingredients/steps are JSON string arrays.
model Recipe {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String
  ingredients Json     @db.JsonB
  steps       Json     @db.JsonB
  tags        String[] @default([])
  servings    Int?
  timeMin     Int?     @map("time_min")
  source      String   @default("manual") // photo | chat | manual
  notes       String?
  timesCooked Int      @default(0) @map("times_cooked")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("recipes")
}

// Structured S&C sessions playable in the workout timer. `definition` is a
// validated JSON of blocks → rounds → exercises (see src/lib/guided-workout.ts).
// plannedWorkoutId is a soft link (no FK) — planned workouts are deleted and
// recreated during week promotion, and the guided session should survive that.
model GuidedWorkout {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  title            String
  focus            String?   // e.g. "core", "hips & glutes", "full body"
  durationMin      Int       @map("duration_min")
  definition       Json      @db.JsonB
  source           String    @default("brocco") // brocco | plan
  plannedWorkoutId String?   @map("planned_workout_id") @db.Uuid
  timesCompleted   Int       @default(0) @map("times_completed")
  pinned           Boolean   @default(false)
  lastUsedAt       DateTime? @map("last_used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions GuidedWorkoutSession[]

  @@index([userId, createdAt])
  @@index([plannedWorkoutId])
  @@map("guided_workouts")
}

// One row per played session — completed or bailed. This is what makes
// progression coaching possible; timesCompleted is just the running count.
model GuidedWorkoutSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  // Null for presets and custom interval timers (no saved row behind them)
  guidedWorkoutId  String?  @map("guided_workout_id") @db.Uuid
  title            String
  startedAt        DateTime @map("started_at")
  finishedAt       DateTime @default(now()) @map("finished_at")
  completed        Boolean  @default(true)
  // How many WORK exercises were done before quitting (null when completed)
  bailedAtExercise Int?     @map("bailed_at_exercise")
  durationMin      Int      @map("duration_min")
  // The logged training activity, so undo can remove both together
  activityId       String?  @map("activity_id") @db.Uuid

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout GuidedWorkout? @relation(fields: [guidedWorkoutId], references: [id], onDelete: SetNull)

  @@index([userId, finishedAt])
  @@index([guidedWorkoutId])
  @@map("guided_workout_sessions")
}

// One row per device/browser the user enabled notifications on
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model InviteCode {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique
  createdBy String    @map("created_by") @db.Uuid
  usedBy    String?   @unique @map("used_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  creator  User  @relation("CreatedInvites", fields: [createdBy], references: [id], onDelete: Cascade)
  redeemer User? @relation("UsedInvite", fields: [usedBy], references: [id], onDelete: SetNull)

  @@map("invite_codes")
}

// ============================================================
// Flexible weekly goals (August 2026)
//
// A target that says "do this N times this week" without pinning it to days —
// how strength, mobility and rehab work actually happen. Deliberately scoped to
// the USER, not to a plan, so someone who lifts and never runs can use them.
// Progress is credited from real activities rather than ticked by hand.
// ============================================================

model WeeklyGoal {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  /// Monday of the week this goal applies to, in the user's timezone.
  weekStart   DateTime     @map("week_start") @db.Date
  category    TaskCategory
  /// What the athlete calls it — "Ankle strength", "Core & hips".
  label       String
  targetCount Int          @map("target_count")
  createdAt   DateTime     @default(now()) @map("created_at")

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits WeeklyGoalCredit[]

  @@unique([userId, weekStart, label])
  @@index([userId, weekStart])
  @@map("weekly_goals")
}

/// One activity counted towards one goal. Credits are written eagerly — a
/// session counts the moment it appears rather than waiting to be attributed —
/// and flagged `provisional` when more than one goal could have claimed it, so
/// the coach knows to confirm. `dismissed` records "asked and rejected", which
/// stops the reconciler re-crediting it on the next pass.
model WeeklyGoalCredit {
  id          String   @id @default(uuid()) @db.Uuid
  goalId      String   @map("goal_id") @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  provisional Boolean  @default(false)
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  goal     WeeklyGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  activity Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([goalId, activityId])
  @@index([activityId])
  @@map("weekly_goal_credits")
}
